<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.claude-usage" path="/org/gnome/shell/extensions/claude-usage/">
    <key name="panel-box" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Panel area</summary>
    </key>
    <key name="panel-index" type="i">
      <range min="0" max="20"/>
      <default>0</default>
      <summary>Position inside the panel area (0 = first)</summary>
    </key>
    <key name="interval" type="i">
      <range min="1" max="60"/>
      <default>5</default>
      <summary>Refresh interval in minutes</summary>
    </key>
    <key name="show-bars" type="b"><default>true</default><summary>Show mini progress bars in the panel</summary></key>
    <key name="show-reset" type="b"><default>true</default><summary>Show 5h reset countdown in the panel</summary></key>
    <key name="show-weekly" type="b"><default>true</default><summary>Show weekly usage in the panel</summary></key>
  </schema>
</schemalist>
